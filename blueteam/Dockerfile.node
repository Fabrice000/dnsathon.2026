FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update -qq && \
    apt-get install -y --no-install-recommends \
    python3 \
    python3-dnspython \
    tcpdump \
    dnsutils \
    iproute2 \
    iptables \
    ca-certificates && \
    rm -rf /var/lib/apt/lists/*
CMD ["tail", "-f", "/dev/null"]
